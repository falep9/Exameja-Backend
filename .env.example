PORT=3333
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173

# Gere segredos locais com: openssl rand -hex 32
CPF_HMAC_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_DE_64_CARACTERES_HEXADECIMAIS
JWT_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_DE_64_CARACTERES_HEXADECIMAIS

AUTH_REGISTRATION_MAX_PER_IP=10
AUTH_PASSWORD_RESET_MAX_PER_IP=5
AUTH_EMAIL_VERIFICATION_MAX_PER_IP=5

# Credenciais do projeto Firebase. Use os valores do seu ambiente local.
FIREBASE_PROJECT_ID=seu-projeto-firebase
FIREBASE_CLIENT_EMAIL=seu-service-account@seu-projeto-firebase.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUA_CHAVE_PRIVADA_AQUI\n-----END PRIVATE KEY-----\n"
FIREBASE_WEB_API_KEY=sua-chave-web-do-firebase

NOMINATIM_USER_AGENT=ExameJa/1.0 (contato: seu-email@exemplo.com)
NOMINATIM_URL=https://nominatim.openstreetmap.org/search

ANS_TUSS_API_URL=https://consulta-ocl.apps.sa-1a.mendixcloud.com/rest/oclservice/ANS/concepts/tuss-43
