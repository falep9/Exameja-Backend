PORT=3333
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173
# Configure conforme a topologia real quando a API estiver atrás de proxy reverso.
# Ex.: TRUST_PROXY_HOPS=1 para exatamente um proxy confiável.
TRUST_PROXY_HOPS=
CPF_HMAC_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres
AUTH_REGISTRATION_MAX_PER_IP=10
AUTH_SESSION_MAX_PER_IP=20
AUTH_PASSWORD_RESET_MAX_PER_IP=5
AUTH_EMAIL_VERIFICATION_MAX_PER_IP=5
CLINIC_SEARCH_MAX_PER_MINUTE=30
EXTERNAL_SEARCH_MAX_PER_MINUTE=30
CNES_SEARCH_MAX_PER_MINUTE=30
GEOCODING_MAX_PER_MINUTE=10
SESSION_COOKIE_SAME_SITE=lax
# Em desenvolvimento com HTTPS local, pode habilitar; produção usa Secure automaticamente.
SESSION_COOKIE_SECURE=false

FIREBASE_PROJECT_ID=seu-project-id
FIREBASE_WEB_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=/caminho/seguro/service-account.json
#Aqui vocês vão colocar o caminho do arquivo JSON que baixaram no computador de vocês, o que eu enviei no grupo.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=


NOMINATIM_USER_AGENT=ExameJa/1.0 (contato: seu-email@exemplo.com)
#Aqui eu coloquei meu e-mail mesmo: leticiamonteiro3107@gmail.com, mas pode colocar seus e-mails individuais
NOMINATIM_URL=https://nominatim.openstreetmap.org/search

#Novas API
ANS_TUSS_API_URL=https://consulta-ocl.apps.sa-1a.mendixcloud.com/rest/oclservice/ANS/concepts/tuss-43
MINISTERIO_SAUDE_API_URL=https://apidadosabertos.saude.gov.br
EXTERNAL_API_TIMEOUT_MS=8000

#Como obter sua chave JWT que é individual de cada programador: openssl rand -hex 32
JWT_SECRET=
